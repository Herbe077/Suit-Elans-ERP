# DATABASE_URL=postgresql+psycopg2://suit:suit@db:5432/suitelans
# Prod cloud (Neon): pega aquí la connection string de Neon (pooler recomendado)
# DATABASE_URL=postgresql://usuario:password@ep-xyz.tech/neondb?sslmode=require
CORS_ORIGINS=http://localhost:8000
TZ=America/Lima
