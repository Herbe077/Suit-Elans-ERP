# --- Suit Elans ERP ---
APP_NAME="Suit Elans ERP & MES"
ENV=dev
# Producción (Render): también acepta ENVIRONMENT=production (tiene prioridad)
# ENVIRONMENT=production
SECRET_KEY=CHANGE_ME_genera_un_secreto_largo_con_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=false
# Dev: por defecto SQLite con ruta absoluta al proyecto (ver app/core/config.py BASE_DIR)
